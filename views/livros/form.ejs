<%- include('../partials/header') %>
<h2><%= titulo %></h2>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>
<% if (!categorias.length) { %>
  <p class="erro">Cadastre uma categoria antes de adicionar livros. <a href="/categorias/nova">Nova categoria</a></p>
<% } else { %>
<form method="POST" action="<%= action %>" class="form">
  <label>Título
    <input type="text" name="titulo" maxlength="200" value="<%= livro.titulo || '' %>" required>
  </label>
  <label>Autor
    <input type="text" name="autor" maxlength="150" value="<%= livro.autor || '' %>" required>
  </label>
  <label>Ano
    <input type="number" name="ano" min="1" value="<%= livro.ano || '' %>">
  </label>
  <label>Categoria
    <select name="categoria_id" required>
      <option value="">Selecione</option>
      <% categorias.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(livro.categoria_id) === String(c.id) ? 'selected' : '' %>><%= c.nome %></option>
      <% }) %>
    </select>
  </label>
  <div class="acoes">
    <button class="btn" type="submit">Salvar</button>
    <a class="btn btn-sec" href="/livros">Cancelar</a>
  </div>
</form>
<% } %>
<%- include('../partials/footer') %>
