<%- include('../partials/header') %>
<div class="barra">
  <h2>Livros</h2>
  <a class="btn" href="/livros/novo">Novo livro</a>
</div>
<% if (!livros.length) { %>
  <p class="vazio">Nenhum livro cadastrado.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Título</th><th>Autor</th><th>Ano</th><th>Categoria</th><th>Ações</th></tr>
    </thead>
    <tbody>
      <% livros.forEach(l => { %>
        <tr>
          <td><%= l.titulo %></td>
          <td><%= l.autor %></td>
          <td><%= l.ano || '-' %></td>
          <td><%= l.categoria %></td>
          <td class="acoes">
            <a class="btn btn-sec" href="/livros/<%= l.id %>/editar">Editar</a>
            <form method="POST" action="/livros/<%= l.id %>/excluir" onsubmit="return confirm('Excluir este livro?')">
              <button class="btn btn-perigo" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('../partials/footer') %>
