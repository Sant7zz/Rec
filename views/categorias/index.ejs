<%- include('../partials/header') %>
<div class="barra">
  <h2>Categorias</h2>
  <a class="btn" href="/categorias/nova">Nova categoria</a>
</div>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>
<% if (!categorias.length) { %>
  <p class="vazio">Nenhuma categoria cadastrada.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Nome</th><th>Descrição</th><th>Livros</th><th>Ações</th></tr>
    </thead>
    <tbody>
      <% categorias.forEach(c => { %>
        <tr>
          <td><%= c.nome %></td>
          <td><%= c.descricao || '-' %></td>
          <td><%= c.total_livros %></td>
          <td class="acoes">
            <a class="btn btn-sec" href="/categorias/<%= c.id %>/editar">Editar</a>
            <form method="POST" action="/categorias/<%= c.id %>/excluir" onsubmit="return confirm('Excluir esta categoria?')">
              <button class="btn btn-perigo" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('../partials/footer') %>
